# ===== Tempo Mainnet Deploy Config =====
# Copy to .env and fill. NEVER commit .env.

# --- Network ---
TEMPO_RPC_URL=https://rpc.tempo.xyz
VERIFIER_URL=https://contracts.tempo.xyz

# --- Tempo fee token (pays gas — Tempo has NO native gas token) ---
# pathUSD on Tempo Mainnet (chain 4217). Deployer wallet MUST hold pathUSD balance for gas.
TEMPO_FEE_TOKEN=0x20c0000000000000000000000000000000000000

# --- Deployer (root key — access keys CANNOT deploy contracts) ---
PRIVATE_KEY=0x

# OWNER must equal vm.addr(PRIVATE_KEY) — Deploy.s.sol enforces this for atomic pool funding.
# Recommendation: deploy with EOA, then call transferOwnership(multisig) on both contracts post-deploy.
OWNER=0x

# --- Tampiyo ERC20 ---
# INITIAL_SUPPLY hardcoded to 1B in Deploy.s.sol (locked per spec). No env var.

# --- TampiyoClaim ---
# Per-claim fee token (set 0x0 = no claim fee). If charging, use pathUSD or your own TIP-20.
FEE_TOKEN=0x0000000000000000000000000000000000000000
# Recipient of per-claim fees (treasury / multisig)
FEE_RECIPIENT=0x
# Raw count of TAMPIYO transferred from OWNER to claim contract pool. Multiplied by 10**18 in Deploy.s.sol.
POOL_AMOUNT=10000

# --- Categories (3 required, indexed 0..2) ---
# AMOUNT and FEE are RAW WEI (NOT auto-scaled). 1 TAMPIYO = 1000000000000000000
# COOLDOWN in seconds. ENABLED = true|false
# SAFETY: deploy with ENABLED=false. Owner calls setCategory post-deploy with production values, then enables.

CAT0_AMOUNT=1000000000000000000
CAT0_COOLDOWN=3600
CAT0_FEE=0
CAT0_ENABLED=false

CAT1_AMOUNT=2000000000000000000
CAT1_COOLDOWN=7200
CAT1_FEE=0
CAT1_ENABLED=false

CAT2_AMOUNT=3000000000000000000
CAT2_COOLDOWN=10800
CAT2_FEE=0
CAT2_ENABLED=false
